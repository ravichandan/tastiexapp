{
  "build": {
    "android": {
      "env": {
        "ENV_FILE": ".env.android"
      }
    },
    "ios": {
      "env": {
        "ENV_FILE": ".env.ios"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "staging",
        "API_URL": "https://staging-api.foodiex.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-creds.json"
      },
      "ios": {
        "appleId": "neelima.salesha2000@gmail.com",
        "ascAppId": "6752925012",
        "appleTeamId": "YA7N8XK8G9",
        "ascApiKeyPath": "APPLE_API_KEY",
        "appleApiKeyId": "9HMP7VN4YD",
        "appleApiIssuerId": "61d60118-57e8-4118-913e-12098b961a19"
      }
    }
    
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
